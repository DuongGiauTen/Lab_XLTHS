//1st requirement
disp("REQUIREMENT 1 Ex 1.1")
disp("x =")
x = 1:4
disp(x)
disp("a = [x[i] + 1]")
a = x + 1
disp(a)

//2nd requirement
disp("REQUIREMENT 2 Ex 1.1")
disp("x =")
x = 1:4
disp(x)

disp("y =")
y = 5:8
disp(y)

disp("b = x1y1 x2y2 ...")
b = x .* y
disp(b)

//3rd requirement
disp("REQUIREMENT 3 Ex 1.1")
disp("x =")

x_new = linspace(0, %pi, 10) 
disp(x_new)

disp("c = sin(x[i])")
c = sin(x_new)
disp(c)
